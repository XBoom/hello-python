# 应用
APP_NAME=Hello Python API
APP_VERSION=0.1.0
DEBUG=true
ENVIRONMENT=development
API_V1_PREFIX=/api/v1

# 安全：生产环境必须替换为足够长的随机字符串
# python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=changeme-please-generate-a-real-secret
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ALGORITHM=HS256

# 数据库
# 本地开发默认 SQLite；Docker / 生产请改用 PostgreSQL
DATABASE_URL=sqlite+aiosqlite:///./app.db
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/hello_python

# CORS，JSON 数组
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# 日志
LOG_LEVEL=INFO
